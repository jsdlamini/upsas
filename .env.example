# Generate secrets locally: openssl rand -base64 48
POSTGRES_USER=upsas
POSTGRES_PASSWORD=
POSTGRES_DB=upsas
DATABASE_URL=postgresql://upsas:CHANGE_ME@db:5432/upsas
SESSION_SECRET=
TOTP_ENC_KEY=
PASSWORD_BLOCKLIST_PATH=./data/password-blocklist.txt
SMTP_HOST=mail.uniswa.sz
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
TZ=Africa/Mbabane
# Deliberately absent: OAUTH_*, SSO_*, LDAP_*, HIBP_API_KEY, any hosted scanning
# provider. No external service participates in verification: sign-in, recovery
# and MFA stay local. Outbound notification mail is the one exception, below.

# Public address of this deployment. Links in emails point here.
APP_URL=http://localhost:3000

# Resend (https://resend.com) sends booking, confirmation and result emails.
# Empty key = emails are written to the server log instead of sent.
RESEND_API_KEY=
# onboarding@resend.dev only delivers to the Resend account owner's own address.
# To reach students and staff, verify a domain in Resend and send from it,
# e.g. UPSAS <upsas@your-verified-domain>.
RESEND_FROM=UPSAS <onboarding@resend.dev>
# Testing: send every email to this one address instead, with the intended
# recipient in the subject. Set it to your Resend account email while you are
# still on onboarding@resend.dev; leave it empty in production.
EMAIL_REDIRECT_TO=
